/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16],inc, load, reset;
    OUT out[16];
    
    PARTS:
    //// Replace this comment with your code.
    Not(in=inc, out=notInc);
    Or(a=notInc, b=load, out=notIncOrload);
    Mux16(a=outInc, b=in, sel=notIncOrload, out=o1);
    Or(a=reset, b=load, out=rOrl);
    Or(a=rOrl, b=inc, out=rOrLOrI);
    Register(in=o2, load=rOrLOrI, out=outR, out=out);
    Inc16(in=outR, out=outInc);
    Mux16(a=o1, b=false, sel=reset, out=o2);
}
